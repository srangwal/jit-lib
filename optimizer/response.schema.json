{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "no-change"
      ]
    },
    "summary": {
      "type": "string"
    },
    "guarantees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "application_references": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only application/path:line references to existing lines in the read-only application. Never original/ or library/ references."
          }
        },
        "required": [
          "claim",
          "application_references"
        ],
        "additionalProperties": false
      },
      "description": "Application usage guarantees supported by application source. Library implementation details belong in why_behavior_is_preserved and library_references."
    },
    "removed_work": {
      "type": "string"
    },
    "library_references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Existing source lines as original/path:line or library/path:line. Include at least one original/ reference identifying unnecessary work."
    },
    "why_behavior_is_preserved": {
      "type": "string"
    },
    "expected_benefit": {
      "type": "string"
    },
    "profile_assessment": {
      "type": "string"
    },
    "local_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "outcome",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "summary",
    "guarantees",
    "removed_work",
    "library_references",
    "why_behavior_is_preserved",
    "expected_benefit",
    "profile_assessment",
    "local_checks",
    "risks"
  ],
  "additionalProperties": false
}
